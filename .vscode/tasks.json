{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake: Configure",
      "type": "shell",
      "command": "/opt/homebrew/bin/cmake",
      "args": [
        "-B", "${workspaceFolder}/build",
        "-G", "Ninja",
        "-DCMAKE_BUILD_TYPE=Debug",
        "-DCMAKE_PREFIX_PATH=/opt/homebrew",
        "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON"
      ],
      "options": {
        "env": { "PATH": "/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin" }
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "CMake: Build",
      "type": "shell",
      "command": "/opt/homebrew/bin/cmake",
      "args": ["--build", "${workspaceFolder}/build"],
      "options": {
        "env": { "PATH": "/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin" }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "dependsOn": ["CMake: Configure"],
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "CMake: Clean Build",
      "type": "shell",
      "command": "rm -rf ${workspaceFolder}/build && /opt/homebrew/bin/cmake -B ${workspaceFolder}/build -G Ninja -DCMAKE_BUILD_TYPE=Debug -DCMAKE_PREFIX_PATH=/opt/homebrew -DCMAKE_EXPORT_COMPILE_COMMANDS=ON && /opt/homebrew/bin/cmake --build ${workspaceFolder}/build",
      "options": {
        "env": { "PATH": "/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin" }
      },
      "group": "build",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Run Tests",
      "type": "shell",
      "command": "/opt/homebrew/bin/ctest",
      "args": ["--test-dir", "${workspaceFolder}/build", "--output-on-failure", "-j4"],
      "options": {
        "env": { "PATH": "/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin" }
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "dependsOn": ["CMake: Build"],
      "problemMatcher": []
    }
  ]
}
