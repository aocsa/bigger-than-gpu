{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake: Configure",
      "type": "shell",
      "command": "cmake",
      "args": ["-B", "${workspaceFolder}/build"],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "CMake: Build",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "${workspaceFolder}/build"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "CMake: Clean Build",
      "type": "shell",
      "command": "rm -rf ${workspaceFolder}/build && cmake -B ${workspaceFolder}/build && cmake --build ${workspaceFolder}/build",
      "group": "build",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Run Tests",
      "type": "shell",
      "command": "ctest",
      "args": ["--test-dir", "${workspaceFolder}/build", "--output-on-failure"],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "dependsOn": ["CMake: Build"],
      "problemMatcher": []
    }
  ]
}
